# ── Secrets ─────────────────────────────────────────────────────────────
# PASTE YOUR KEYS BELOW. This file is gitignored; never commit it.

# Pinecone console → API Keys
PINECONE_API_KEY=

# https://openrouter.ai/keys  (used for BOTH embeddings and generation)
OPENROUTER_API_KEY=

# ── Models ──────────────────────────────────────────────────────────────
# Swappable so the eval harness can compare them empirically.
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536
PINECONE_NAMESPACE=__default__
GEN_MODEL=google/gemini-3.8-flash
# MUST differ from GEN_MODEL (a model grading its own output has a self-preference bias).
# Was qwen/qwen3.8-flash, changed after it began returning sustained upstream 429s that
# lost ~30% of judge calls in a run — an eval you cannot trust is worse than a slow one.
JUDGE_MODEL=z-ai/glm-5.3-flash

# ── Index ───────────────────────────────────────────────────────────────
PINECONE_INDEX=studio-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── Retrieval ───────────────────────────────────────────────────────────
# Calibrated in Tier 2: k=5 left 3 answerable questions unanswered because the gold chunk
# sat at fused rank 6-8, and the model correctly refused rather than inventing. k=8 took
# judge correctness 93.3% -> 100% and false abstentions 3 -> 0, for $0.0004 more per question.
TOP_K=8                 # chunks passed to the generator
CANDIDATES=20           # per-arm depth before RRF fusion
RRF_K=60                # RRF constant: score = 1/(RRF_K + rank)

# BM25 arm weighting, calibrated on the 55 golden questions (eval/run.py sweep).
# Plain RRF (weight 1.0, depth 20) scored WORSE than dense alone — recall@5 73% vs 87% —
# because a doc present in both arms outranks one the dense arm put first and BM25 never
# returned. Down-weighting the arm and cutting its noisy tail keeps the 3 gold chunks
# BM25 alone rescues without letting it scramble a good dense ordering.
RRF_TEXT_WEIGHT=0.1     # dense arm is weight 1.0
RRF_TEXT_DEPTH=5        # BM25 hits beyond this rank are dropped before fusion

# Abstention gate: raw dense top-1 score, read BEFORE fusion.
# Do NOT gate on the RRF score — it is rank-only, so top-1 is always 1/61.
# Calibrated (PLAN phase 9) on golden.yaml: the lowest-scoring ANSWERABLE question scores
# 0.210 and the highest-scoring out-of-scope one 0.466, so the distributions overlap. The
# only floor with abstention precision 1.0 sits below 0.210 and catches 2 of 10 out-of-scope
# questions. This gate is therefore a thin backstop, not the primary defence — the grounding
# prompt carries abstention, and Tier 2 measures it.
SCORE_FLOOR=0.20

# ── Answers ─────────────────────────────────────────────────────────────
ANSWER_TARGET_CHARS=320
ANSWER_MAX_CHARS=480

# ── Twilio SMS transport ────────────────────────────────────────────────────────────
# Console -> Account Info. The auth token also signs incoming webhooks, so it is what
# src/sms.py validates X-Twilio-Signature against.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=          # the number you bought, E.164 e.g. +15551234567

# The EXACT url you paste into the Twilio console as the messaging webhook. Signature
# validation hashes this string; a mismatch 403s every legitimate request.
TWILIO_WEBHOOK_URL=          # e.g. https://your-tunnel.ngrok-free.app/sms

SMS_WORKERS=4                # concurrent answers in flight; a burst queues, never drops

# Per-sender rate limit. Rejected messages cost nothing — the check runs before retrieval.
# A sender crossing the limit gets ONE notice, then silence until the window rolls off.
SMS_RATE_LIMIT=15            # messages per sender per window
SMS_RATE_WINDOW=3600         # window in seconds

# ── Conversation history ────────────────────────────────────────────────────────────
# Every text in and out is stored in this SQLite file, whatever USE_HISTORY says.
# USE_HISTORY only controls whether past messages are shown to the generator.
HISTORY_DB=history.db
USE_HISTORY=true
HISTORY_MESSAGES=6           # how many past texts the model sees
HISTORY_HOURS=24             # and how far back to look

# Rewrites a follow-up into a standalone search query before retrieval. Only fires when
# there IS history, so first messages cost nothing extra. Measured: multi-turn retrieval
# 10/12 -> 12/12, topic changes and abstention unchanged, about $0.0006 a message.
USE_QUERY_REWRITE=true
REWRITE_MODEL=z-ai/glm-5.3-flash
